rules_version = '2';

// Firestore security rules for "its giving.AI"
//
// Every user's data is isolated under users/{uid}/...
// No user can read or write another user's data.
// The backend function (admin SDK) bypasses these rules.

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own data.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Usage is written only by the Cloud Functions Admin SDK. Clients may
      // read their current allowance but cannot reset or inflate counters.
      match /usage/{document=**} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // User-owned data excluding the server-managed usage collection.
      match /{collection}/{document=**} {
        allow read, write: if request.auth != null &&
          request.auth.uid == uid && collection != 'usage';
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
