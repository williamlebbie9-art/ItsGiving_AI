rules_version = '2';

// Firestore security rules for "its giving.AI"
//
// Every user's data is isolated under users/{uid}/...
// No user can read or write another user's data.
// The backend function (admin SDK) bypasses these rules.

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own data.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // All subcollections inherit the parent rule.
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}